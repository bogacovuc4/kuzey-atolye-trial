# Site adresi (SEO, sitemap ve paylaşım kartları için)
NEXT_PUBLIC_SITE_URL=https://www.dokunusakademi.com

# Google Analytics 4 ölçüm kimliği (ör. G-XXXXXXX). Boş bırakılırsa analitik yüklenmez.
# Analitik yalnızca ziyaretçi çerez onayı verdikten sonra çalışır.
NEXT_PUBLIC_GA_ID=

# Yönetim paneli (/yonetim) şifresi. En az 12 karakter, tahmin edilemez bir değer seçin.
ADMIN_PASSWORD=

# Oturum çerezini imzalamak için rastgele uzun bir metin (ör. `openssl rand -hex 32`)
SESSION_SECRET=

# İsteğe bağlı: yeni randevu talebi geldiğinde bildirim gönderilecek webhook adresi
# (Make, Zapier, n8n, Slack vb.). Boş bırakılırsa yalnızca veritabanına kaydedilir.
NOTIFY_WEBHOOK_URL=
